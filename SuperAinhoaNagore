/* ---------- Estado ---------- */
const CH=[{n:'Ainhoa',h:1.85,w:.7,sp:7.3,j:20.5,hair:'brown',band:'red',shirt:'white',pants:'blue',s:1},{n:'Nagore',h:1.4,w:.55,sp:6.6,j:21,hair:'blonde',band:'pink',shirt:'pink',pants:'purple',s:.76}];
let solids=[],blocks=[],cns=[],pows=[],foes=[],shots=[],parts=[],clouds=[],P=null,st='menu',sel=0,score=0,coins=0,lives=3,t=0,paused=false,fx={},keys={},cp=0,jb=0,cx=3,camZ=13,tt,lv=0,GX=146,GROUND=[],mode=0,ls=0,lc=0;
const at=(x,y)=>solids.some(s=>x>s.x0&&x<s.x1&&y>s.y0&&y<s.y1);
const hit=(b,s)=>b.x+b.w/2>s.x0&&b.x-b.w/2<s.x1&&b.y+b.h>s.y0&&b.y<s.y1;
