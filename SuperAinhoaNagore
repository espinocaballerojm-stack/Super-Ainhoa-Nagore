function mkPlayer(c){const o=new THREE.Group(),b=new THREE.Group(),s=c.s;b.scale.setScalar(s);o.add(b);scene.add(o);
 const lg=[-1,1].map(k=>{const p=new THREE.Group();p.position.set(k*.17,.72,0);box(p,M[c.pants],0,-.36,0,.27,.72,.27);b.add(p);return p});
 const ar=[-1,1].map(k=>{const p=new THREE.Group();p.position.set(k*.4,1.4,0);box(p,M.skin,0,-.3,0,.18,.62,.18);b.add(p);return p});
 box(b,M[c.shirt],0,1.08,0,.62,.74,.4);ball(b,M.skin,0,1.78,0,.38);ball(b,M[c.hair],0,1.9,-.06,.41,.33,.41);ball(b,M[c.hair],0,1.62,-.26,.3,.36,.2);ball(b,M[c.band],-.12,2.13,0,.13);ball(b,M[c.band],.12,2.13,0,.13);ball(b,M.dark,-.14,1.8,.34,.06);ball(b,M.dark,.14,1.8,.34,.06);
 const hold=new THREE.Group();hold.scale.setScalar(s);o.add(hold);const sh=ball(o,M.shield,0,c.h/2,0,c.h*.62);sh.castShadow=false;
 return{c,o,b,lg,ar,hold,sh,x:0,y:0,vx:0,vy:0,w:c.w,h:c.h,g:0,cy:0,inv:0,cd:0,swing:0,dir:1,ry:Math.PI/2-.35,hk:null}}
function move(b,dt){
 b.x+=b.vx*dt;for(const s of solids)if(hit(b,s)){b.x=b.vx>0?s.x0-b.w/2:s.x1+b.w/2;b.vx=0}
 b.y+=b.vy*dt;b.g=0;for(const s of solids)if(hit(b,s)){if(b.vy<=0){b.y=s.y1;b.g=1}else{b.y=s.y0-b.h;if(s.blk)bump(s.blk)}b.vy=0}}
function gain(){coins++;score+=10;sfx(988,.1,'square',1318);if(coins%25===0){lives++;toast('¡Vida extra! ❤️',1500)}}
function bump(k){k.t=.22;sfx(220,.1,'square',330);if(k.used||k.type!=='q')return;k.used=1;k.body.material=M.used;
 if(k.p==='coin'){gain();burst(k.x,k.y+1.1,'#ffe77a')}else pows.push({x:k.x,y:k.y+.9,w:.8,h:.9,vx:(Math.random()<.5?-1:1)*1.8,vy:7,k:k.p,mesh:mkPow(k.p),got:0})}
function grab(b){b.got=1;W.remove(b.mesh);score+=50;sfx(660,.25,'triangle',1320,.06);burst(b.x,b.y+.5,'#fff0a1',14);
 if(b.k==='mushroom'){fx.shield=1;toast('🛡️ ¡Escudo de estrella!')}
 else if(b.k==='skate'){fx.skate=10;toast('🛼 ¡Patines! Velocidad extra')}
 else if(b.k==='sword'){fx.arm='sword';toast('⚔️ ¡Espada! Pulsa X o ✦')}
 else{fx.arm='wand';toast('🪄 ¡Varita! Pulsa X o ✦')}}
function kill(e){e.dead=.4;score+=100;burst(e.x,.8,'#ffd23f');sfx(300,.15,'square',90)}
function hurt(x0){if(P.inv>0)return;sfx(160,.3,'sawtooth',60,.06);P.inv=2;P.vy=8;P.vx=(P.x<x0?-1:1)*7;
 if(fx.shield){fx.shield=0;toast('¡El escudo te protegió!',1200)}else{lives--;if(lives<=0)over(0)}}
function attack(){if(st!=='play'||paused||P.cd>0)return;const a=fx.arm;if(!a){toast('Busca una espada ⚔️ o una varita 🪄 en los bloques',1600);P.cd=.8;return}
 P.cd=a==='sword'?.4:.3;P.swing=.22;sfx(a==='sword'?500:880,.14,'sawtooth',200,.04);
 if(a==='sword'){for(const e of foes)if(!e.dead&&Math.abs(e.x-(P.x+P.dir*1.1))<1.7&&Math.abs(P.y-e.y)<1.8)kill(e)}
 else shots.push({x:P.x+P.dir*.6,y:P.y+P.h*.6,vx:P.dir*13,life:1.4,mesh:ball(FX,M.gold,0,0,0,.26)})}

function step(dt){
 if(st!=='play')return;
 const L=keys.ArrowLeft||keys.KeyA,Rt=keys.ArrowRight||keys.KeyD,J=keys.Space||keys.ArrowUp||keys.KeyW,d=(Rt?1:0)-(L?1:0),sp=P.c.sp*(fx.skate>0?1.5:1)*(keys.KeyX||keys.KeyZ?1.6:1);
 if(d)P.dir=d;P.vx+=(d*sp-P.vx)*Math.min(1,(P.g?16:9)*dt);
 P.cy=P.g?.1:P.cy-dt;jb-=dt;P.inv-=dt;P.cd-=dt;P.swing-=dt;
 if(fx.skate>0){fx.skate-=dt;if(fx.skate<=0)toast('Se acabaron los patines')}
 if(jb>0&&P.cy>0){P.vy=P.c.j;P.cy=0;jb=0;sfx(380,.16,'square',760)}
 P.vy-=G*dt*(!J&&P.vy>0?2:1);P.vy=Math.max(P.vy,-30);move(P,dt);
 if(P.g)for(const [a] of GROUND)if(P.x>a+2)cp=Math.max(cp,a+2);
 if(P.y<-9){lives--;if(lives<=0){over(0);return}P.x=cp;P.y=1;P.vx=P.vy=0;P.inv=2;toast('¡Cuidado con los huecos!',1200)}
 if(P.x>=GX){over(1);return}
 for(const e of foes){
  if(e.dead){e.dead-=dt;e.mesh.scale.y=Math.max(.05,e.dead*2.5);if(e.dead<=0){W.remove(e.mesh);e.rm=1}continue}
  e.x+=e.dir*e.sp*dt;const ax=e.x+e.dir*.75;if(!at(ax,-.4)||at(ax,.5))e.dir*=-1;
  e.y=e.ty===2?Math.abs(Math.sin(t*3+e.x))*2:Math.abs(Math.sin(t*9+e.x))*.1;e.mesh.position.set(e.x,e.y,0);e.mesh.rotation.y=e.dir*.6;
  if(Math.abs(P.x-e.x)<(P.w+1.1)/2&&P.y<e.y+1.2&&P.y+P.h>e.y){if(P.vy<-1&&P.y>e.y+.55){kill(e);P.vy=J?17:11;sfx(520,.12,'square',900)}else hurt(e.x)}}
 foes=foes.filter(e=>!e.rm);
 for(const s of shots){s.x+=s.vx*dt;s.life-=dt;s.mesh.position.set(s.x,s.y,0);if(Math.random()<.4)burst(s.x,s.y,'#fff0a1',1);
  for(const e of foes)if(!e.dead&&Math.abs(e.x-s.x)<.9&&s.y<e.y+1.6){kill(e);s.life=0}
  if(at(s.x,s.y))s.life=0;if(s.life<=0)FX.remove(s.mesh)}
 shots=shots.filter(s=>s.life>0);
 for(const b of pows){b.vy-=G*dt;move(b,dt);if(b.g)b.vx*=.92;b.mesh.position.set(b.x,b.y+.45,0);b.mesh.rotation.y=t*2;
  if(!b.got&&Math.abs(P.x-b.x)<(P.w+b.w)/2&&P.y<b.y+b.h&&P.y+P.h>b.y)grab(b)}
 pows=pows.filter(b=>!b.got);
 for(const c of cns)if(!c.got&&Math.abs(P.x-c.x)<.8&&Math.abs(P.y+P.h/2-c.y)<P.h/2+.4){c.got=1;c.mesh.visible=false;gain()}
 for(const k of blocks){if(k.t>0){k.t-=dt;k.mesh.position.y=k.y+Math.sin(Math.max(0,k.t)/.22*Math.PI)*.25}}
 for(const p of parts){p.vy-=18*dt;p.m.position.x+=p.vx*dt;p.m.position.y+=p.vy*dt;p.l-=dt;if(p.l<=0)FX.remove(p.m)}
 parts=parts.filter(p=>p.l>0);
}
function anim(dt){if(!P)return;const m=Math.min(1,Math.abs(P.vx)/P.c.sp),w=Math.sin(t*13)*.9*m;
 P.lg[0].rotation.x=P.g?w:.5;P.lg[1].rotation.x=P.g?-w:-.4;P.ar[0].rotation.x=P.g?-w:-2.4;P.ar[1].rotation.x=P.g?w:-2.4;
 P.b.position.y=P.g?Math.abs(Math.sin(t*13))*.06*m:0;P.ry+=(P.dir*(Math.PI/2-.35)-P.ry)*Math.min(1,14*dt);P.b.rotation.y=P.ry;
 P.o.position.set(P.x,P.y,0);P.o.visible=!(P.inv>0&&((t*14)|0)%2);P.sh.visible=!!fx.shield;
 if(P.hk!==fx.arm){P.hk=fx.arm;P.hold.clear();if(fx.arm==='sword'){box(P.hold,M.stone,0,.5,0,.1,.9,.06);box(P.hold,M.gold,0,.05,0,.36,.08,.1)}else if(fx.arm==='wand'){box(P.hold,M.wood,0,.35,0,.07,.7,.07);ball(P.hold,M.gold,0,.8,0,.17)}}
 P.hold.position.set(P.dir*.55*P.c.s,P.h*.42,.35);P.hold.rotation.z=P.swing>0?-P.dir*Math.sin(P.swing/.22*Math.PI)*1.6:0}
function hud(){const set=(e,v)=>{if(e.textContent!==''+v)e.textContent=v};set(E.v,lv+1);set(E.c,coins);set(E.s,score);set(E.l,lives);
 set(E.p,(fx.shield?'🛡️ ':'')+(fx.skate>0?'🛼'+Math.ceil(fx.skate)+' ':'')+(fx.arm==='sword'?'⚔️':fx.arm==='wand'?'🪄':''));E.b.style.width=Math.min(100,Math.max(0,P.x/GX*100))+'%'}

/* ---------- Flujo ---------- */
function start(i,keep){sel=i;if(!keep){score=coins=0;lives=3;lv=0;fx={}}ls=score;lc=coins;paused=false;cp=0;jb=0;build();P=mkPlayer(CH[i]);menu.classList.add('hidden');end.classList.add('hidden');st='play';cx=3;toast(`Nivel ${lv+1} · ¡Vamos, ${CH[i].n}!`,1800);document.activeElement?.blur?.()}
function over(win){st='end';toast('');const more=win&&lv<NL-1;if(win)score+=lives*200;mode=win?(more?1:0):2;sfx(win?880:150,.5,win?'triangle':'sawtooth',win?1320:60,.06);
 $('endEyebrow').textContent=win?(more?`NIVEL ${lv+1} COMPLETADO`:'MISIÓN COMPLETADA'):'¡ÁNIMO!';$('endTitle').textContent=win?(more?'¡BIEN HECHO!':'¡VICTORIA!'):'¡OTRA VEZ!';$('endScore').textContent=`⭐ ${score} · 🪙 ${coins}`;
 $('endText').textContent=win?(more?`¡${P.c.n} lo logró! Prepárate para el nivel ${lv+2}.`:`¡${P.c.n} salvó el Reino de las Estrellas!`):`${P.c.n} se quedó sin vidas. ¡Inténtalo otra vez, tú puedes!`;
 $('again').textContent=more?'Siguiente nivel ▶':win?'Volver a jugar':'Reintentar nivel';end.classList.remove('hidden')}
function pause(force){if(st!=='play')return;paused=force||!paused;toast(paused?'⏸ PAUSA':'',1e9)}
$('again').onclick=()=>{if(mode===1){lv++;lives=Math.min(5,lives+1);fx.skate=0;start(sel,1)}else if(mode===2){lives=3;score=ls;coins=lc;start(sel,1)}else start(sel)};
$('change').onclick=()=>{lv=0;build();st='menu';end.classList.add('hidden');menu.classList.remove('hidden')};
document.querySelectorAll('.pick').forEach(b=>b.addEventListener('click',()=>{Music.play();start(+b.dataset.char)}));

/* ---------- Controles ---------- */
function press(c,d){keys[c]=d;if(!d)return;if(JUMP.includes(c))jb=.13;else if(c==='KeyX'||c==='KeyZ')attack();else if(c==='KeyP'||c==='Escape')pause();else if(c==='KeyM')$('mute').click()}
addEventListener('keydown',e=>{if(JUMP.concat(['ArrowDown','ArrowLeft','ArrowRight']).includes(e.code))e.preventDefault();if(!e.repeat)press(e.code,true)});
addEventListener('keyup',e=>press(e.code,false));
addEventListener('blur',()=>{keys={}});
document.querySelectorAll('.touch').forEach(b=>{const c=b.dataset.key;
 b.addEventListener('pointerdown',e=>{e.preventDefault();try{b.setPointerCapture(e.pointerId)}catch{}b.classList.add('down');press(c,true)});
 const up=()=>{b.classList.remove('down');press(c,false)};['pointerup','pointercancel','lostpointercapture'].forEach(n=>b.addEventListener(n,up));
 b.addEventListener('contextmenu',e=>e.preventDefault())});
/* Sin barra de copiar / seleccionar / menú contextual */
['contextmenu','selectstart','dragstart','gesturestart','dblclick'].forEach(n=>addEventListener(n,e=>e.preventDefault()));


/* ---------- Bucle ---------- */
function rs(){R.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix();camZ=cam.aspect<1?15.7/cam.aspect:13*Math.max(1,1.7/cam.aspect)}
addEventListener('resize',rs);addEventListener('orientationchange',()=>setTimeout(rs,250));
build();rs();let last=performance.now();
R.setAnimationLoop(now=>{
 const dt=Math.min(.033,(now-last)/1000);last=now;t+=dt;
 if(st==='play'&&!paused){step(dt/2);step(dt/2);if(P)hud()}
 anim(dt);
 for(const c of clouds){c.position.x+=c.userData.s*dt;if(c.position.x>GX+40)c.position.x=-12}
 cns.forEach((c,i)=>{c.mesh.rotation.y=t*3+i});
 cx+=((P?P.x:0)+3-cx)*Math.min(1,7*dt);const py=P?Math.max(0,P.y)*.3:0;
 const ly=cam.aspect<1?5.5:2.6;cam.position.set(cx,ly+2.6+py,camZ);cam.lookAt(cx,ly+py,0);sun.position.set(cx-12,22,15);sun.target.position.set(cx,0,0);
 R.render(scene,cam)});
</script></body></html>
