 const arc=(x,n)=>{for(let i=0;i<n;i++)coin(x+i*1.1,1.4+Math.sin(Math.PI*i/(n-1))*1.3)};
 GROUND.forEach(([a,b],i)=>{const w=b-a,x=(a+b)/2;box(W,M.soil,x,-2.5,0,w,5,7);box(W,M.grass,x,.03,0,w+.04,.14,7.04);solids.push({x0:a,x1:b,y0:-60,y1:0});
  for(let q=a+4;q<b-2;q+=6+(q%3|0))tree(q+(q*7%3),-2.6);
  if(i){const g=a-GROUND[i-1][1];if(g>4.2){const sx=a-g/2;box(W,M.stone,sx,1.05,0,1.6,.7,3);solids.push({x0:sx-.8,x1:sx+.8,y0:.7,y1:1.4});coin(sx,2.8)}}});
