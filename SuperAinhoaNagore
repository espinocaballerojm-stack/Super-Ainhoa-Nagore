const Music=(()=>{let c,m,nz,nt=0,ix=0,mu=0,tm;
 const mel=[72,0,76,0,79,0,76,0,74,0,76,0,72,0,0,0,69,0,72,0,76,0,72,0,71,0,72,0,69,0,0,0,65,0,69,0,72,0,69,0,67,0,69,0,72,0,74,0,67,0,71,0,74,0,71,0,72,0,74,0,76,0,0,0],rt=[48,45,41,43],hz=n=>440*2**((n-69)/12);
 const tn=(f,t,d,ty,v)=>{const o=c.createOscillator(),g=c.createGain();o.type=ty;o.frequency.value=f;g.gain.setValueAtTime(.0001,t);g.gain.linearRampToValueAtTime(v,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g);g.connect(m);o.start(t);o.stop(t+d+.02)};
 const ns=(t,d,hp,v)=>{const n=c.createBufferSource(),f=c.createBiquadFilter(),g=c.createGain();n.buffer=nz;f.type='highpass';f.frequency.value=hp;g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);n.connect(f);f.connect(g);g.connect(m);n.start(t);n.stop(t+d)};
 const sch=(i,t)=>{const s=i%64,b=s>>4,k=s&15;if(mel[s])tn(hz(mel[s]),t,.24,'triangle',.07);if(k%4==0)tn(hz(rt[b]),t,.32,'triangle',.14);if(k==6||k==14)tn(hz(rt[b]+7),t,.18,'triangle',.09);if(k==4||k==12)ns(t,.1,1800,.1);if(k%2==0)ns(t,.03,7500,.04)};
 return{play(){try{c=actx();if(c.state==='suspended')c.resume();if(!m){m=c.createGain();m.connect(c.destination);nz=c.createBuffer(1,c.sampleRate*.2|0,c.sampleRate);const d=nz.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;nt=c.currentTime+.08;tm=setInterval(()=>{if(nt<c.currentTime)nt=c.currentTime+.05;while(nt<c.currentTime+.2){sch(ix++,nt);nt+=60/128/4}},50)}m.gain.setTargetAtTime(mu?0:.55,c.currentTime,.08)}catch{}},
  toggle(){mu^=1;if(m)m.gain.setTargetAtTime(mu?0:.55,c.currentTime,.05);return mu}}})();
