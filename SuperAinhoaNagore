 for(let i=0;i<16+lv*3;i++){const g=new THREE.Group();[[0,0,0,.85],[.7,.1,0,.65],[-.65,.04,0,.58],[.2,.38,0,.58]].forEach(([a,b,c,r])=>ball(g,M.cloud,a,b,c,r));g.scale.setScalar(1.5+Math.random()*2);g.position.set(Math.random()*(GX+40)-10,10+Math.random()*10,-8-Math.random()*22);g.traverse(o=>o.castShadow=false);g.userData.s=.2+Math.random()*.4;W.add(g);clouds.push(g)}
