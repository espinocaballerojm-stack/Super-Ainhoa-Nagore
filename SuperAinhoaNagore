const mat=(c,r=.75,m=0)=>new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m});
const qt=(()=>{const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');x.fillStyle='#f6a928';x.fillRect(0,0,64,64);x.strokeStyle='#b66a2b';x.lineWidth=6;x.strokeRect(3,3,58,58);x.fillStyle='#fff';x.font='900 44px system-ui';x.textAlign='center';x.textBaseline='middle';x.fillText('?',32,35);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t})();
