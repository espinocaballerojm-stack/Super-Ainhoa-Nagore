const PM={},pm=c=>PM[c]||=mat(c,.5);
function burst(x,y,c,n=10){for(let i=0;i<n;i++){const m=new THREE.Mesh(SG,pm(c));m.scale.setScalar(.05+Math.random()*.08);m.position.set(x,y,0);FX.add(m);parts.push({m,vx:(Math.random()-.5)*5,vy:Math.random()*5+1,l:.5+Math.random()*.4})}}

/* ---------- Nivel ---------- */
function tree(x,z){const g=new THREE.Group();g.position.set(x,.1,z);W.add(g);box(g,M.wood,0,.9,0,.34,1.8,.34);ball(g,M.leaf,0,2,0,.9,.95,.9);ball(g,M.leaf2,-.42,1.75,.1,.6);ball(g,M.leaf,.42,1.78,-.1,.56)}
function mkBlock(x,type,p){const g=new THREE.Group(),y=3.9;g.position.set(x,y,0);W.add(g);const body=box(g,type==='q'?M.qb:M.brick,0,0,0,1.8,1.8,1.8),k={x,y,type,p,used:0,t:0,mesh:g,body};blocks.push(k);solids.push({x0:x-.9,x1:x+.9,y0:y-.9,y1:y+.9,blk:k})}
function mkPow(k){const g=new THREE.Group();
 if(k==='mushroom'){ball(g,M.red,0,.2,0,.5,.4,.5);box(g,M.white,0,-.15,0,.4,.35,.4);ball(g,M.white,-.2,.35,.3,.12);ball(g,M.white,.2,.3,.3,.12)}
 else if(k==='skate'){box(g,M.cyan,0,-.2,0,1,.16,.45);[-.32,.32].forEach(x=>ball(g,M.dark,x,-.35,.15,.12))}
 else if(k==='sword'){box(g,M.stone,0,.2,0,.14,.85,.1);box(g,M.gold,0,-.2,0,.5,.1,.14);box(g,M.wood,0,-.38,0,.13,.3,.13)}
 else{box(g,M.wood,0,0,0,.1,.85,.1);ball(g,M.gold,0,.55,0,.22);ball(g,M.cyan,0,.55,.08,.12)}
 W.add(g);return g}
function coin(x,y){const g=new THREE.Group();g.position.set(x,y,0);const a=new THREE.Mesh(CG,M.gold);a.castShadow=true;g.add(a,new THREE.Mesh(OG,M.white));W.add(g);cns.push({x,y,mesh:g,got:0})}
function foe(x,ty=0){const g=new THREE.Group(),m=[M.red,M.purple,M.blue][ty];W.add(g);ball(g,m,0,.62,0,.66,.55,.6);[-.22,.22].forEach(k=>{ball(g,M.white,k,.75,.42,.17);ball(g,M.dark,k,.74,.58,.08)});[-.32,.32].forEach(k=>box(g,m,k,.12,.05,.2,.25,.4));foes.push({x,y:0,ty,sp:(ty===1?3.4:1.9)*(1+lv*.07),dir:-1,dead:0,mesh:g})}
const TH=[['#8edcff','#a8e5ff','#53c95b','#7fd98c',2],['#ffb57a','#ffd2a6','#c9b24a','#e0a35a',1.9],['#3d3a8c','#5a56b4','#3f9a8a','#4c57a8',1],['#cfeeff','#e6f6ff','#f1f8ff','#bcd9ee',2.1],['#ff9ec4','#ffc3dc','#7be0a5','#ff9ed0',2]];
