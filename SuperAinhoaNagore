function build(){
 if(P){scene.remove(P.o);P=null}
 W.clear();FX.clear();solids=[];blocks=[];cns=[];pows=[];foes=[];shots=[];parts=[];clouds=[];
 const T=TH[lv%TH.length],r=rng(lv*977+31);
 scene.background.set(T[0]);scene.fog.color.set(T[1]);M.grass.color.set(T[2]);M.hill.color.set(T[3]);hemi.intensity=T[4];
 GX=140+lv*16;GROUND=[[-12,34]];let a=34;
 while(a<GX-10){const s0=a+3.2+r()*1.4+lv*.15,len=Math.max(13,16+r()*12-lv*1.5)|0;GROUND.push([s0,s0+len]);a=s0+len}
